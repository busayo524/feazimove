# Production build config — safe to commit (contains only public URLs/tokens)
#
# VITE_API_URL is deliberately NOT set here. It used to pin the bundle to one
# backend at build time, which broke production the moment a Development build
# was promoted: the live site kept calling the Development API and every login
# failed on CORS. src/services/api.js now picks the backend from the hostname at
# runtime, so one artifact is correct in both environments.
# Set VITE_API_URL only for a local build aimed at a specific backend.
VITE_MIXPANEL_TOKEN=bb428598f7ce68442834bdfab4d62fe9
